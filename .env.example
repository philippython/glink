# Copy to .env (or set in your host) — everything is optional for local development.
# In production set at least NODE_ENV=production and an https APP_URL. See docs/DEPLOYMENT.md.

NODE_ENV=development

PORT=8787
APP_URL=http://localhost:5173        # public URL of the web app (OAuth redirects, email links)
DATABASE_PATH=server/data/glink.db   # SQLite file
UPLOAD_DIR=server/data/uploads       # where uploaded videos are stored
MAX_UPLOAD_MB=500
SEED_DEMO=                           # true/false — demo accounts (password demo1234). Default: on in development, off in production
ALLOW_TEST_FUNDS=                    # true/false — “Add test funds” + $5,000 welcome credit. Default: on in development, off in production

# Social sign-in — each provider appears on the login/sign-up pages once its keys are set.
# Redirect / callback URL to register with each provider: $APP_URL/api/auth/oauth/<provider>/callback

# Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook (developers.facebook.com → your app → Facebook Login; request the "email" permission)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple (developer.apple.com → Identifiers → Services ID with "Sign in with Apple"; Keys → a key with Sign in with Apple)
# Apple requires an https APP_URL. Put the .p8 key on one line, in double quotes, with \n for line breaks.
APPLE_CLIENT_ID=            # the Services ID, e.g. com.yourco.glink.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Card payments (Stripe) — brands top up with Stripe Checkout, creators are paid with Stripe Connect.
# dashboard.stripe.com → Developers → API keys. Use sk_test_… keys until you go live.
# Webhook: Developers → Webhooks → Add endpoint $APP_URL/api/stripe/webhook with the events
#   checkout.session.completed, checkout.session.async_payment_succeeded, account.updated
# (and "Listen to events on Connected accounts" for account.updated). Paste its signing secret below.
# Locally: `stripe listen --forward-to localhost:8787/api/stripe/webhook` prints a whsec_… to use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Escrow automation (see docs/ESCROW.md). Defaults shown; 0 turns reminders or auto-approval off.
REVIEW_REMINDER_DAYS=2      # brand reminded once when a video waits this long
AUTO_APPROVE_DAYS=5         # clean videos (no failed checks) approved automatically after this many days
AUTO_PAYOUT_MIN=20          # USD; creators with a connected bank are paid automatically from this balance

# Email (Resend) — password resets and team invites. resend.com → API Keys; verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=                 # e.g. Glink <hello@yourdomain.com> — must be on a domain verified in Resend

# Optional AI layer for pre-flight frame review and product analysis
ANTHROPIC_API_KEY=
